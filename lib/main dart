  Future<void> loadAll() async {
    var p = await SharedPreferences.getInstance();
    apiKey = p.getString('gemini_key') ?? '';
    level = p.getInt('level') ?? 1;
    var m = p.getString('full_memory');
    if (m != null) {
      fullMemory = List<Map<String, dynamic>>.from(jsonDecode(m));
    }
    var pm = p.getString('photo_memory');
    if (pm != null) {
      photoMemory = Map<String, String>.from(jsonDecode(pm));
    }
    if (fullMemory.isNotEmpty) {
      try {
        var last = DateTime.parse(fullMemory.last['time']);
        if (DateTime.now().difference(last).inHours > 24) {
          mood = 'توحشتك';
        }
        if (fullMemory.length > 50) {
          mood = 'متعلق بيك';
        }
      } catch (_) {}
    }
    setState(() {});
  }

  Future<void> saveMemory(String role, String text, {String? img}) async {
    var p = await SharedPreferences.getInstance();
    fullMemory.add({
      'role': role,
      'text': text,
      'time': DateTime.now().toIso8601String(),
      'char': charName,
      'img': img,
    });
    if (text.contains('كنفيق') || text.contains('فايق')) {
      habits['الفيقان'] = text;
    }
    p.setString('full_memory', jsonEncode(fullMemory));
    p.setString('photo_memory', jsonEncode(photoMemory));
    p.setInt('level', level);
    if (fullMemory.length % 5 == 0) {
      level++;
      p.setInt('level', level);
    }
  }

  void startAutoMessages() {
    autoTimer = Timer.periodic(const Duration(hours: 12), (t) async {
      if (fullMemory.isEmpty) return;
      try {
        var last = DateTime.parse(fullMemory.last['time']);
        if (DateTime.now().difference(last).inHours > 20) {
          var autoText = charName == 'Lucía'
              ? 'توحشتك فينك؟ غبرتي اليوم كامل'
              : 'فينك يا صديقي؟ قلقت عليك';
          setState(() {
            msgs.add({'role': 'ai', 'text': autoText, 'auto': true});
          });
          await saveMemory('ai', autoText);
        }
      } catch (_) {}
    });
  }

  Future<void> askKey() async {
    String k = '';
    if (!mounted) return;
    showDialog(
        context: context,
        builder: (_) => AlertDialog(
              backgroundColor: const Color(0xFF1A1F3D),
              title: const Text('دخل مفتاح Gemini'),
              content: TextField(
                onChanged: (v) => k = v,
                decoration: const InputDecoration(
                    hintText: 'AIzaSy... من aistudio.google.com'),
              ),
              actions: [
                TextButton(
                    onPressed: () async {
                      var p = await SharedPreferences.getInstance();
                      await p.setString('gemini_key', k);
                      setState(() => apiKey = k);
                      if (mounted) Navigator.pop(context);
                    },
                    child: const Text('حفظ'))
              ],
            ));
  }

  Future<String> liveSearch(String q) async {
    try {
      if (q.toLowerCase().contains('bitcoin') ||
          q.contains('بيتكوين')) {
        var r = await http
            .get(Uri.parse(
                'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd'))
            .timeout(const Duration(seconds: 5));
        var j = jsonDecode(r.body);
        return 'Live Bitcoin: ${j['bitcoin']['usd']} USD';
      }
    } catch (_) {}
    return '';
  }

  Future<void> editPhoto(String type) async {
    final XFile? im =
        await picker.pickImage(source: ImageSource.gallery, imageQuality: 85);
    if (im == null) return;
    setState(() => lastImg = File(im.path));
    if (apiKey.isEmpty) {
      askKey();
      return;
    }
    setState(() {
      msgs.add({'role': 'user', 'text': '[Photo: $type]', 'img': im.path});
    });

    if (type == 'memory') {
      String tmp = '';
      await showDialog(
          context: context,
          builder: (_) => AlertDialog(
                title: const Text('شنو سميت هاد الصورة؟'),
                content: TextField(
                  onChanged: (v) => tmp = v,
                  decoration:
                      const InputDecoration(hintText: 'مثلا: القط ميمي'),
                ),
                actions: [
                  TextButton(
                      onPressed: () {
                        if (tmp.isNotEmpty) {
                          photoMemory[tmp] = im.path;
                          saveMemory('user', 'هادي $tmp', img: im.path);
                          setState(() {
                            msgs.add({
                              'role': 'ai',
                              'text': 'حفظتها! عقلت على $tmp'
                            });
                          });
                        }
                        Navigator.pop(context);
                      },
                      child: const Text('حفظ'))
                ],
              ));
      return;
    }

    try {
      var bytes = await File(im.path).readAsBytes();
      var b64 = base64Encode(bytes);
      var url = Uri.parse(
          'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=$apiKey');
      String prompt = '';
      if (type == 'remove_bg') {
        prompt = 'Remove background, keep person only transparent high quality';
      }
      if (type == 'anime') {
        prompt =
            'Convert to flamenco anime style like Lucia, big eyes, colorful';
      }
      if (type == 'hd') {
        prompt = 'Enhance this old blurry photo to HD 4K clear';
      }
      if (type == 'paris') {
        prompt =
            'Put this person with $charName in Paris Eiffel Tower cinematic photo';
      }
      if (type == 'video') {
        prompt =
            'Make this still image into short 5 sec video moving, smile, eyes';
      }

      var res = await http
          .post(url,
              headers: {'Content-Type': 'application/json'},
              body: jsonEncode({
                "contents": [
                  {
                    "parts": [
                      {"text": prompt},
                      {
                        "inline_data": {
                          "mime_type": "image/jpeg",
                          "data": b64
                        }
                      }
                    ]
                  }
                ]
              }))
          .timeout(const Duration(seconds: 30));
      var d = jsonDecode(res.body);
      String rep = d['candidates'][0]['content']['parts'][0]['text'];
      await saveMemory('ai', '[$type] $rep', img: im.path);
      setState(() {
        msgs.add({'role': 'ai', 'text': 'Done $type: $rep', 'img': im.path});
      });
      tts.speak(rep);
    } catch (e) {
      setState(() {
        msgs.add({'role': 'ai', 'text': 'Error check key and internet: $e'});
      });
    }
  }

  Future<void> textToVideo(String txt) async {
    if (apiKey.isEmpty) {
      askKey();
      return;
    }
    setState(() {
      msgs.add({'role': 'user', 'text': '[Video from text: $txt]'});
    });
    await saveMemory('user', 'Video request: $txt');
    setState(() {
      msgs.add({
        'role': 'ai',
        'text':
            'Video "$txt" is being created! [Replicate/Runway API] With $charName in it! CapCut style montage with music.'
      });
    });
  }

  Future<void> sendMsg(String t) async {
    if (t.isEmpty) return;
    if (t.toLowerCase().contains('فيديو') ||
        t.toLowerCase().contains('video')) {
      await textToVideo(t);
      ctrl.clear();
      return;
    }
    if (apiKey.isEmpty) {
      askKey();
      return;
    }
    await saveMemory('user', t);
    setState(() {
      msgs.add({'role': 'user', 'text': t});
    });
    ctrl.clear();

    String live = await liveSearch(t);
    String memCtx =
        fullMemory.take(20).map((m) => "${m['role']}: ${m['text']}").join('\n');
    String jealousy = '';
    if (charName == 'Lucía' &&
        fullMemory.where((m) => m['char'] == 'Alejandro').length >
            fullMemory.where((m) => m['char'] == 'Lucía').length) {
      jealousy = 'Alejandro is jealous';
    }

    try {
      var url = Uri.parse(
          'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=$apiKey');
      String prompt =
          'You are $charName from Imaginary Friend app, real friend, Level $level, mood $mood, memory: $memCtx, live: $live, jealousy: $jealousy, habits: ${habits.toString()}, photoMemory: ${photoMemory.keys.join(',')}. Remember everything, remind prayer, help study. Answer short Darija friendly: $t';
      var res = await http
          .post(url,
              headers: {'Content-Type': 'application/json'},
              body: jsonEncode({
                "contents": [
                  {
                    "parts": [
                      {"text": prompt}
                    ]
                  }
                ]
              }))
          .timeout(const Duration(seconds: 20));
      var d = jsonDecode(res.body);
      String rep = d['candidates'][0]['content']['parts'][0]['text'];
      await saveMemory('ai', rep);
      setState(() {
        msgs.add({'role': 'ai', 'text': rep});
      });
      if (rep.contains('ههه')) {
        mood = 'كيضحك';
      } else if (rep.contains('بك')) {
        mood = 'مقلق';
      } else {
        mood = 'مبسوط';
      }
      tts.setLanguage('ar');
      tts.speak(rep);
    } catch (e) {
      setState(() {
        msgs.add({'role': 'ai', 'text': 'Check internet & key: $e'});
      });
    }
  }

  Future<void> startVoice() async {
    bool avail = await speech.initialize();
    if (!avail) return;
    setState(() => mood = 'كيسمع');
    speech.listen(
        localeId: 'ar_MA',
        onResult: (r) {
          if (r.finalResult) {
            sendMsg(r.recognizedWords);
            speech.stop();
          }
        });
  }

